# Copy this file to .env and adjust the values for your environment.
# docker-compose reads .env automatically.
#
# ===== Credentials (dev-only defaults — ALWAYS override in production) =====
# Values are intentionally empty so no real secret is committed.
POSTGRES_PASSWORD=
RABBITMQ_PASSWORD=
GRAFANA_ADMIN_PASSWORD=

# ===== Secrets (REQUIRED in production) =====
# JWT signing key (>= 32 chars). The backend fails to start in prod without it.
JWT_SECRET=
# Webhook secrets for each platform. Webhooks are rejected when unset.
GITHUB_WEBHOOK_SECRET=
GITLAB_WEBHOOK_SECRET=
BITBUCKET_WEBHOOK_SECRET=
AZURE_DEVOPS_WEBHOOK_SECRET=

# ===== Integrations =====
OPENROUTER_API_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITLAB_TOKEN=
BITBUCKET_USERNAME=
BITBUCKET_APP_PASSWORD=
JIRA_URL=
JIRA_USERNAME=
JIRA_API_TOKEN=
LINEAR_API_KEY=
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
SONARQUBE_URL=
SONARQUBE_TOKEN=
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
